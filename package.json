{
  "name": "pixeltoolkit",
  "productName": "PixelToolkit",
  "version": "0.1.0",
  "private": true,
  "description": "PixelToolkit: pixel art tooling (Skeletal Animator) built on Electron, Vue and three.js",
  "main": "./out/main/index.js",
  "author": "Alexander Howe",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev --remoteDebuggingPort 9222",
    "dev:testbed": "electron-vite dev -- --testbed",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:scripts",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "fixtures": "tsx scripts/fetch-fixtures.ts",
    "test": "npm run test:rig && npm run test:main && npm run test:docs && npm run test:playback && npm run test:pixelart",
    "test:rig": "tsx scripts/verify-rig.ts",
    "test:main": "tsx scripts/test-main-fs.ts && tsx scripts/test-jobs.ts",
    "test:docs": "tsx --tsconfig tsconfig.web.json src/renderer/src/stores/doc/selftest.ts",
    "test:playback": "tsx --tsconfig tsconfig.web.json src/renderer/src/stores/job/playbackJobs.test.ts",
    "test:pixelart": "tsx scripts/test-pixelart.ts",
    "verify:rig": "npm run test:rig",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "dev:testbed:debug": "electron-vite dev --remoteDebuggingPort 9222 -- --testbed"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@lucide/vue": "^1.49.0",
    "pinia": "^4.0.3",
    "pngjs": "^7.0.0",
    "three": "^0.186.1",
    "vue-draggable-plus": "^0.6.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.1",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
